PORT=5000
# Shared team database (MongoDB Atlas). Ask a teammate for the real connection string
# and put it in your own .env — never commit real credentials here.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DB_NAME=sipnow
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
CLIENT_URLS=http://localhost:5173
